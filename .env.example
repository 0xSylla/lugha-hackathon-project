# Postgres connection string (Neon: use the pooled "-pooler" URL from the dashboard)
NEON_POSTGRES=
# 32+ char random string (encryption at rest)
APP_SECRET=change-me-to-a-long-random-string

# ---- Payments on QDay Aevum testnet (chain 44005) ----
# 1 = simulated payments, no chain needed (demo/tests). 0 = real tUSD8 through the TaskEscrow contract.
MOCK_PAYMENTS=0
# The deployed TaskEscrow (see contracts/README or `forge script script/Deploy.s.sol`).
ESCROW_ADDRESS=
# The operator's key: records accepted answers, releases due payments and relays requesters' signed funding,
# so it needs a little tQDAY for gas. Use a FRESH test wallet that holds nothing else. The contract only lets it
# pay a task's fixed rates to workers. Mark it Sensitive on your host.
OPERATOR_PRIVATE_KEY=
# Optional: another RPC (defaults to https://rpc-test.qday.info)
AEVUM_RPC=
# Seconds an accepted answer is held in the escrow before it can be released (also the on-chain hold, max 7 days)
PAYOUT_COOLDOWN_SECS=60
# Per-worker cap over 24 hours, in micro tUSD8 (2000000 = $2)
DAILY_CAP_MICRO=2000000

# ---- Grader (Google Gemini, key from aistudio.google.com/apikey). Empty = basic offline heuristic grader. ----
GEMINI_API_KEY=
GRADER_MODEL=gemini-3.5-flash
AUDIO_GRADER_MODEL=gemini-2.5-flash
GRADER_FALLBACK_MODEL=gemini-2.5-flash

# Nostr relays (comma separated) for publishing tasks and dataset attestations
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# Load demo tasks (simulated payments only)
SEED_DEMO=0
# Languages switched on for training (build-time). Comma-separated registry names, or * for all plus any typed name.
NEXT_PUBLIC_LANGUAGES=English,Nigerian Pidgin,Yoruba,Hausa
# Source link shown on the landing page
NEXT_PUBLIC_REPO_URL=
